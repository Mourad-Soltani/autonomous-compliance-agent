datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SOC2Category {
  SECURITY
  AVAILABILITY
  PROCESSING_INTEGRITY
  CONFIDENTIALITY
  PRIVACY
}

enum PolicySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  NOT_EVALUATED
  NOT_APPLICABLE
  PARTIALLY_COMPLIANT
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model Control {
  id           String             @id
  category     SOC2Category
  title        String
  description  String
  tscReference String
  severity     PolicySeverity
  isAutomated  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  evaluations  EvaluationResult[]
  evidence     Evidence[]

  @@map("controls")
}

model AuditRun {
  id                String             @id @default(uuid())
  timestamp         DateTime           @default(now())
  totalControls     Int
  compliantCount    Int
  nonCompliantCount Int
  notEvaluatedCount Int

  results           EvaluationResult[]

  @@map("audit_runs")
}

model Evidence {
  id            String            @id @default(uuid())
  controlId     String
  sourceAdapter String
  timestamp     DateTime          @default(now())
  rawPayload    Json
  resourceArn   String?

  control       Control           @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evaluations   EvaluationResult[] @relation("EvaluationToEvidence")

  @@index([controlId])
  @@index([sourceAdapter])
  @@map("evidence")
}

model EvaluationResult {
  id               String           @id @default(uuid())
  auditRunId       String
  controlId        String
  status           ComplianceStatus
  evaluatedAt      DateTime         @default(now())
  findings         String[]
  remediationSteps String[]

  auditRun         AuditRun         @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  control          Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidenceList     Evidence[]       @relation("EvaluationToEvidence")

  @@index([auditRunId])
  @@index([controlId])
  @@map("evaluation_results")
}

// ============================================
// Auth & Identity Models
// ============================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  apiKeys   ApiKey[]
  ssoConfig SSOConfig?

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  avatar         String?
  role           UserRole  @default(MEMBER)
  status         UserStatus @default(ACTIVE)
  passwordHash   String?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  apiKeys      ApiKey[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@map("users")
}

model ApiKey {
  id             String    @id @default(uuid())
  name           String
  keyHash        String    @unique
  keyPrefix      String
  scopes         String[]
  userId         String
  organizationId String?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("api_keys")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id       String   @id @default(uuid())
  userId   String
  action   String
  resource String
  metadata Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model SSOConfig {
  id           String   @id @default(uuid())
  organizationId String @unique
  provider     String
  clientId     String
  clientSecret String
  issuerUrl    String
  authorizationUrl String?
  scopes       String?
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sso_configs")
}
