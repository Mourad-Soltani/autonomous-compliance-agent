# ============================================
# Autonomous Compliance Agent — Configuration
# ============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/compliance_agent

# --- AWS Configuration ---
# Set these to enable LIVE AWS evidence collection and remediation.
# If omitted, the agent runs in MOCK mode (simulated data).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Optional: S3 bucket for CloudTrail logs (auto-created if not set)
AWS_CLOUDTRAIL_BUCKET=compliance-audit-logs

# --- GitHub Configuration ---
# Set these to enable LIVE GitHub evidence collection and remediation.
# If omitted, the agent runs in MOCK mode (simulated data).
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_TOKEN=ghp_your_personal_access_token
# Required GitHub token scopes: repo, admin:repo_hook

# --- Slack Notifications (optional) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#compliance-alerts

# --- Server ---
PORT=3000