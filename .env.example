# ============================================
# Autonomous Compliance Agent — Environment
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Security ---
JWT_SECRET=change-me-in-production-min-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL + Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/compliance_db?schema=public

# --- AWS Configuration ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_ACCOUNT_ID=123456789012
AWS_CLOUDTRAIL_BUCKET=your-cloudtrail-bucket

# --- GitHub Configuration ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# --- Azure Configuration ---
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_RESOURCE_GROUP=compliance-rg

# --- GCP Configuration ---
GCP_PROJECT_ID=your-gcp-project-id

# --- Kubernetes ---
KUBECONFIG=/path/to/kubeconfig

# --- Notifications ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
WEBHOOK_URL=https://your-callback.url/compliance-events

# --- Audit & Export ---
EXPORT_DIR=./exports
AUDITOR_PORTAL_URL=http://localhost:3000/audit
