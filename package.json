{
  "name": "autonomous-compliance-agent",
  "version": "1.0.1",
  "description": "Autonomous AI agent for continuous SOC 2 compliance evaluation and evidence collection",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "dashboard": "echo 'Dashboard available at http://localhost:3000/dashboard (start server first: npm run server)'",
    "bundle": "node scripts/bundle.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.525.0",
    "@aws-sdk/client-iam": "^3.525.0",
    "@aws-sdk/client-s3": "^3.525.0",
    "@azure/arm-keyvault": "^3.1.0",
    "@azure/arm-network": "^33.0.0",
    "@azure/arm-storage": "^18.2.0",
    "@azure/identity": "^4.0.0",
    "@prisma/client": "^5.10.0",
    "body-parser": "^1.20.2",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.57.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/bcryptjs": "^2.4.6"
  }
}